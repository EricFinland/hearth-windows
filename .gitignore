.env
*.key
.DS_Store
Thumbs.db

# python bytecode
__pycache__/
*.pyc

# editor and local tooling scratch directories
.vscode/
.idea/

# vendored llama.cpp binaries. Fetched by scripts/vendor_llama.py from the
# release pinned in vendor/llama_manifest.json, which IS committed. Native
# binaries are not: they are large, platform-specific, and reproducible from
# the pin, so the manifest is the thing worth reviewing in a diff.
vendor/llama/
vendor/cache/

# vendored CPython, same reasoning as the llama binaries above. Fetched by
# scripts/vendor_python.py from the release pinned in
# vendor/python_manifest.json, which IS committed.
vendor/python/

# windows packaging. build/ holds the assembled payload, the cargo target
# directory and the bundler's output. All of it is reproducible from a
# checkout by scripts/build_windows.py and all of it is hundreds of
# megabytes. Anchored to the repository root on purpose, so that a build/
# somewhere inside desktop/ stays a deliberate decision rather than an
# accident of this line.
/build/

# generated by tauri-build on every compile, out of tauri.conf.json,
# capabilities/ and the command list in build.rs, all of which are
# committed. Reviewing a diff of a machine's restatement of the files above
# it is not reviewing anything.
desktop/tauri/gen/
desktop/tauri/permissions/autogenerated/

# scripts/build_windows.py redirects cargo's output into /build/, so this
# only catches a bare `cargo build` run by hand inside the crate.
desktop/tauri/target/

# release signing keys. The PUBLIC half lives in release/trust.json, which IS
# committed and ships inside the installer; the private seed belongs offline
# and must never be in a repository. *.key above already covers it; this entry
# is here so the intent is visible in the ignore file rather than inferred.
release/keys/

# The scripts that produced this repository from the private development
# repository, and the audit that checks the result. They live here so they sit
# beside the thing they build and can be re-run when the source moves on, but
# they are not part of the application and they describe the layout of a
# repository that is not public, so they are not published with it.
/tooling/
