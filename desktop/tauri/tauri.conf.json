{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "version": "0.1.0",
  "identifier": "com.hearthlocal.hearth",
  "build": {
    "frontendDist": "../../build/ui-embed"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright (c) 2026 Eric Catalano",
    "category": "DeveloperTool",
    "shortDescription": "Run local LLMs. One install, no terminal.",
    "longDescription": "Hearth runs a local language model on your own machine, with an approval gate in front of anything that writes.",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../build/stage/python": "python",
      "../../build/stage/hearth": "hearth",
      "../../LICENSE": "LICENSE.hearth.txt",
      "../../NOTICE": "NOTICE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsi"
      }
    }
  }
}
