{
  "name": "hearth",
  "productName": "Hearth",
  "version": "0.1.0",
  "description": "Run local LLMs. One install, no terminal.",
  "author": {
    "name": "Eric Catalano"
  },
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hearthlocal.hearth",
    "productName": "Hearth",
    "copyright": "Copyright (c) 2026 Eric Catalano",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "../../build/dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "origin.js",
      "sidecar.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/stage/python",
        "to": "python"
      },
      {
        "from": "../../build/stage/hearth",
        "to": "hearth"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Hearth-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hearth",
      "uninstallDisplayName": "Hearth ${version}",
      "deleteAppDataOnUninstall": false,
      "menuCategory": false
    }
  }
}
